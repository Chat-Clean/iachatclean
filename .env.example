# ===========================================================
#  SDR Virtual ChatClean — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
# ===========================================================

# Chave da OpenAI (com crédito)
OPENAI_API_KEY=sk-...

# URL autenticada gerada em Configurações → API/Webhook → Adicionar (no painel ChatClean).
# O token JWT já vem embutido como ?token=... — não precisa de header.
CC_PUSH_URL=https://betaapi.chatclean.com.br/v1/api/external/UUID/?token=JWT

# WhatsApp interno que recebe o resumo dos leads qualificados (opcional).
EQUIPE_NUMERO=5584999999999

# Token para validar o webhook de entrada.
# O ChatClean hoje NÃO envia token no header → DEIXE VAZIO.
WEBHOOK_SECRET=

# Números liberados na fase de teste (separados por vírgula).
# Vazio = responde a todos. Tolerante ao 9º dígito.
IA_ALLOWED_CONTACTS=5584999999999

# Persistência do estado das conversas (recomendado em produção).
# Sem REDIS_URL, o estado fica em memória e se perde no restart/redeploy.
REDIS_URL=
REDIS_PREFIX=chatclean-sdr

# Porta do servidor
PORT=3000

# Reinicia o atendimento após N horas sem interação do cliente (padrão: 24)
RESET_INATIVIDADE_HORAS=24

# --- Google Calendar (opcional — ver GOOGLE_CALENDAR_SETUP.md) ---
# Sem estas variáveis, o bot só coleta o horário preferido e a equipe agenda manual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Agendas do time p/ verificar disponibilidade (e-mails, separados por vírgula)
GOOGLE_TEAM_CALENDARS=alan@gmail.com,especialista2@gmail.com
# Agenda onde o evento é criado (padrão: a primeira da lista acima)
GOOGLE_BOOKING_CALENDAR=
# Duração da reunião em minutos
REUNIAO_DURACAO_MIN=30
