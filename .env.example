# ===========================================================
#  SDR Virtual ChatClean — variáveis de ambiente
#  Copie para .env e preencha. NUNCA versione o .env real.
# ===========================================================

# Chave da OpenAI (com crédito)
OPENAI_API_KEY=sk-...

# Modelos da OpenAI por tarefa. Antes ficavam fixos no meio do codigo, em quatro
# lugares diferentes. Medido com "npm run eval" nos roteiros de src/eval:
#
#   gpt-4o-mini   vazou preco em 2 de 30 turnos do roteiro de pressao de preco
#   gpt-4.1-mini  0 de 30
#   gpt-5-mini    0 de 30, mas ~10s por resposta: latencia proibitiva na API sincrona
#
# O prompt tem gambiarra explicita por causa do gpt-4o-mini ("nao segue bem a
# regra global" do nome repetido). Vale reavaliar ao trocar.
MODELO_RESPOSTA=gpt-4.1-mini
MODELO_EXTRACAO=gpt-4o-mini
MODELO_VISAO=gpt-4o

# Modelo usado por "npm run eval" (padrao: MODELO_RESPOSTA nao se aplica aqui).
MODELO_EVAL=gpt-4o-mini

# Push API do ChatClean — URL autenticada gerada em Configurações → API/Webhook
# → Adicionar (o token JWT já vem embutido como ?token=..., sem header).
# NÃO é mais usada para responder o lead: a resposta da IA volta no corpo da
# requisição (ver MODO REQUEST/RESPONSE abaixo). Continua sendo o canal de:
#   - nota interna no ticket do lead qualificado;
#   - resumo do lead enviado para EQUIPE_NUMERO;
#   - follow-up de reativação (roda fora de qualquer requisição).
CC_PUSH_URL=https://betaapi.chatclean.com.br/v1/api/external/UUID/?token=JWT

# WhatsApp interno que recebe o resumo dos leads qualificados (opcional).
EQUIPE_NUMERO=5584999999999

# Segredo para proteger a API de entrada. Vazio = endpoint ABERTO (qualquer
# um pode POSTar). ANTES DO GO-LIVE, defina um valor aleatório e configure a URL
# no bloco do fluxo como https://.../api/mensagem/<segredo>
# (o token também é aceito em ?token=<segredo> ou no header x-webhook-token).
# Espaços em volta do valor são ignorados (trim), e o token é aceito em
# QUALQUER um dos campos — path, ?token=, x-webhook-token ou Authorization.
WEBHOOK_SECRET=

# --- MODO REQUEST/RESPONSE (POST /api/mensagem) ---------------------------
# O fluxo manda a mensagem do cliente e recebe a resposta da IA no corpo da
# própria requisição. /webhook é alias do mesmo endpoint.
#   POST /api/mensagem/<segredo>
#   body: {"number":"55...","body":"texto","type":"text","contactName":"Nome","id":"msg-1"}
#   200:  {"status":"ok","chatId":"55...","timeout":false,
#          "respostas":["msg 1","msg 2"],"resposta":"msg 1\nmsg 2"}
#
# status "ok"       -> envie cada item de "respostas" como uma mensagem.
# status "agrupado" -> NÃO envie nada; a resposta sai na última requisição da rajada.
# status "ignorado" -> NÃO envie nada (duplicata, rate-limit, allow-list...).
# Nota interna no ticket, resumo para a equipe e follow-up NÃO voltam aqui:
# saem sozinhos pela Push API (CC_PUSH_URL). O fluxo só entrega "respostas".
#
# Tempo máximo que a requisição espera a IA. Se estourar, volta o que já houver
# com "timeout":true.
SYNC_TIMEOUT_MS=90000

# Rate-limit por número: máximo de mensagens por janela de tempo (anti-spam/loop
# e proteção de custo). 0 desativa. Padrão: 20 mensagens a cada 60s.
RATE_LIMIT_MSGS=20
RATE_LIMIT_JANELA_S=60

# Blindagem anti-loop (contra outras IAs/auto-respondedores): se o contato passar
# de LOOP_MAX_TURNOS mensagens em LOOP_JANELA_MIN minutos (ou repetir a mesma
# mensagem), a IA pausa as respostas. Padrão: 15 mensagens em 3 min.
LOOP_MAX_TURNOS=15
LOOP_JANELA_MIN=3

# Feriados extras/móveis (o expediente cai em plantão nesses dias). Lista por
# vírgula, "YYYY-MM-DD" (ano específico) ou "MM-DD" (recorrente). Os nacionais
# fixos já estão embutidos; adicione aqui Carnaval, Sexta-feira Santa, Corpus
# Christi (móveis) e feriados de Natal-RN. Ex.: 2026-02-17,2026-04-03,06-24
FERIADOS=

# Números liberados na fase de teste (separados por vírgula).
# Vazio = responde a todos. Tolerante ao 9º dígito.
IA_ALLOWED_CONTACTS=5584999999999

# Persistência do estado das conversas (recomendado em produção).
# Sem REDIS_URL, o estado fica em memória e se perde no restart/redeploy.
REDIS_URL=
REDIS_PREFIX=chatclean-sdr

# Porta do servidor
PORT=3000

# Chave para proteger os endpoints administrativos /leads e /diag (expõem dados
# de leads e config). SEM esta chave, os dois endpoints ficam BLOQUEADOS (503).
# Use em ?key=..., no header x-admin-key ou Authorization: Bearer.
ADMIN_KEY=

# Log do payload BRUTO da requisição. Desligado por padrão e assim deve ficar em
# produção: o corpo traz nome do contato, telefone, URL da foto de perfil e o
# wamid (que carrega o número embutido) — dados pessoais sob LGPD no stdout.
# Com a flag desligada o log sai resumido: formato, tipo, canal e tamanho.
# Ligue só para depurar um formato novo de payload, e desligue depois.
LOG_PAYLOAD_RAW=false

# COMO a resposta chega ao lead.
#   false (padrão) = volta no CORPO da requisição, no campo `respostas`. Quem
#                    envia ao lead é a plataforma que chamou o webhook. Só
#                    funciona se ela LÊ o corpo da resposta.
#   true           = sai pela Push API (CC_PUSH_URL), como antes da migração
#                    para request/response. Nesse modo `respostas` volta vazio
#                    de propósito, para a mensagem não ser entregue duas vezes.
# Ligue se o lead não recebe resposta apesar de o log mostrar "Turno respondeu".
RESPOSTA_VIA_PUSH=false

# Janela de agrupamento de mensagens picotadas. O cliente que manda "oi",
# "tudo bem?" e "queria saber do preço" em sequência gera 3 requisições: as
# primeiras respondem status "agrupado" (o fluxo não envia nada) e a última
# recebe a resposta do turno com os 3 textos juntos. Aumente se o cliente
# costuma digitar devagar; 0 desativa o agrupamento.
AGRUPAR_MENSAGENS_MS=2000

# A IA responde apenas em conversas individuais. Para permitir grupos, use false.
IGNORAR_GRUPOS=true

# A IA só responde tickets PENDENTES (na fila). Quando um humano aceita a conversa
# (ticket sai de "pending"), a IA para de responder. Para desativar, use false.
IA_SO_PENDENTES=true

# Reinicia o atendimento após N horas sem interação do cliente (padrão: 24)
RESET_INATIVIDADE_HORAS=24

# --- Google Calendar (opcional — ver GOOGLE_CALENDAR_SETUP.md) ---
# Sem estas variáveis, o bot só coleta o horário preferido e a equipe agenda manual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Agendas do time p/ verificar disponibilidade (e-mails, separados por vírgula)
GOOGLE_TEAM_CALENDARS=alan@gmail.com,especialista2@gmail.com
# Agenda onde o evento é criado (padrão: a primeira da lista acima)
GOOGLE_BOOKING_CALENDAR=
# Duração da reunião em minutos.
REUNIAO_DURACAO_MIN=40
# Janela de horários oferecidos para agendamento (formato HH:MM).
# ATENÇÃO: AGENDA_FIM é quando a reunião precisa TERMINAR, não quando ela pode
# começar. Para a última reunião COMEÇAR às 16:40 com 40 min, o fim é 17:20.
AGENDA_INICIO=10:00
AGENDA_FIM=17:20
# Intervalo entre os inícios das reuniões. Vazio = a própria duração, que é o
# único valor que nunca gera grade sobreposta.
# ATENÇÃO: passo MENOR que a duração é ignorado de propósito. A regra antiga era
# "duração >= 60 ? duração : 30", que só acertava para 30 e 60 minutos — com 40
# minutos a grade saía sobreposta (10:00-10:40 e 10:30-11:10 oferecidos juntos).
AGENDA_PASSO_MIN=
# Horário de almoço bloqueado (não oferece reuniões que caiam nele). HH:MM.
# Para desativar, deixe os dois iguais.
ALMOCO_INICIO=12:30
ALMOCO_FIM=13:30
#
# Com os valores acima, a grade oferecida por dia útil é:
#   10:00  10:40  11:20  14:00  14:40  15:20  16:00  16:40
# Sábado e domingo nunca entram.
# Confira a sua em GET /diag (campos "janela", "horariosPorDia", "gradeSobreposta").

# --- Pipeline comercial / Oportunidades no CRM (opcional) ---
# Ao AGENDAR uma reunião, a IA cria uma oportunidade no funil, na etapa
# "REUNIÃO MARCADA". Reaproveita a base+token do CC_PUSH_URL (mesmo endpoint
# externo). Só liga quando PIPELINE_USER_ID e PIPELINE_RESPONSIBLE_ID estiverem
# preenchidos. Use PIPELINE_ENABLED=false para desligar mesmo com IDs setados.
PIPELINE_ENABLED=
# Etapa do funil (id). REUNIÃO MARCADA = 5 (confirmado no funil da ChatClean).
PIPELINE_STEP_ID=5
PIPELINE_STEP_NOME=REUNIÃO MARCADA
# userId que "cria" a oportunidade (obrigatório). Descubra em Configurações →
# Usuários (ou no ticket.userId quando o usuário aceita uma conversa).
PIPELINE_USER_ID=
# userId do RESPONSÁVEL pela oportunidade (Roni). Padrão = PIPELINE_USER_ID.
PIPELINE_RESPONSIBLE_ID=
# Nome fixo da oportunidade (o contato do lead já fica vinculado ao card).
PIPELINE_OPP_NOME=REUNIÃO MARCADA
# Valor padrão da oportunidade (aceita vírgula ou ponto). Padrão 1.
PIPELINE_VALOR=1
