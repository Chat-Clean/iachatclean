{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "node18",
        "resolveJsonModule": true,
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "maxNodeModuleJsDepth": 0,
        "types": ["node"]
    },
    "include": ["src/domain/**/*.js", "src/application/**/*.js", "src/shared/**/*.js"],
    "exclude": ["node_modules", "test", "coverage"]
}
